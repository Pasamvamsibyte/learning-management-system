PORT=5000
DATABASE_URL=postgresql://lms_user:change_me_local_password@localhost:5432/lms_db
JWT_SECRET=replace_this_with_a_long_random_secret_before_running
CLIENT_ORIGIN=http://localhost:5173

# Optional online payments (Razorpay test/live keys; configure only on the backend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPLOAD_DIR=./uploads

# Recommended for online deployment: S3-compatible private object storage (e.g. AWS S3, Cloudflare R2, MinIO)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
